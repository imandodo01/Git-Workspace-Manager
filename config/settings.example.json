{
  "workspace": {
    "root": "C:/Path/To/Your/Workspace",
    "recursiveDiscovery": true,
    "excludedDirectories": [
      ".git",
      "node_modules",
      "vendor",
      ".venv"
    ]
  },
  "git": {
    "defaultRemote": "origin",
    "syncStrategy": "ff-only",
    "fetchPrune": false
  },
  "reporting": {
    "formats": [
      "json",
      "html"
    ],
    "outputDirectory": "reports",
    "keepHistory": true,
    "retentionCount": 30
  },
  "logging": {
    "enabled": true,
    "path": "logs",
    "retentionCount": 30
  },
  "integration": {
    "vscodeEnabled": true,
    "autoOpenAttentionRepositories": false
  }
}
